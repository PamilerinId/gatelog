# Local development. Every value here is a development default; production values come from
# Secret Manager (see the repo README). Never commit a real .env.
ENV=development
CORS_ORIGINS=http://localhost:3000

# The API connects as gatelog_app (not the table owner) so Row-Level Security applies.
DATABASE_URL=postgresql+psycopg://gatelog_app:gatelog_app@localhost:54329/gatelog
DATABASE_OWNER_URL=postgresql+psycopg://gatelog_owner:gatelog_owner@localhost:54329/gatelog

# Shared with the web app and Cloud Scheduler.
# API_INTERNAL_TOKEN=

# Required in production (the API refuses to start with the dev defaults):
# TOKEN_SECRET=                 at least 32 random bytes
# PHONE_ENCRYPTION_KEY=         Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PHONE_INDEX_KEY=              random string, never rotated casually (it indexes every number)
# KEY_STORE=gcp                 per-estate HMAC keys in Secret Manager
# GCP_PROJECT=

# Messaging. "console" logs masked instead of sending; "live" uses Termii and WhatsApp.
MESSAGING_PROVIDER=console
# TERMII_API_KEY=
# TERMII_SENDER_ID=Gatelog
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=          verifies Meta's webhook signature
# WHATSAPP_VERIFY_TOKEN=
# SMS_WEBHOOK_SECRET=           path secret for /v1/webhooks/sms/<secret>
# POSTMARK_SERVER_TOKEN=
# OPS_EMAIL=                    state-tier directory alerts, SMS budget alerts
# FCM_PROJECT=                  push "sync now" to gate phones
