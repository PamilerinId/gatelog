NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API_BASE_URL=http://localhost:8000
# API_INTERNAL_TOKEN=
# Lead delivery until the API persists them (Postmark):
# POSTMARK_SERVER_TOKEN=
# LEADS_EMAIL_FROM=hello@yourdomain
# LEADS_EMAIL_TO=you@yourdomain
# The estate map's satellite imagery (see docs/map-tiles.md). Unset: Esri World Imagery,
# for prototype use only. Production: Mapbox Satellite or Google.
# NEXT_PUBLIC_MAP_PROVIDER=mapbox
# NEXT_PUBLIC_MAP_TILES_URL=https://api.mapbox.com/v4/mapbox.satellite/{z}/{x}/{y}@2x.jpg90?access_token=pk.your-public-token
# NEXT_PUBLIC_MAP_ATTRIBUTION=© Mapbox © Maxar
# NEXT_PUBLIC_MAP_MAX_ZOOM=19
# NEXT_PUBLIC_MAP_TILE_SIZE=512
# Where the map editor opens before an estate has a boundary (lng,lat).
# NEXT_PUBLIC_MAP_DEFAULT_CENTER=3.385,6.615
